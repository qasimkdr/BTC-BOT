# V3 TradingAgents — SHADOW ONLY
V3_SHADOW_ENABLED=false
V3_SCAN_INTERVAL_MS=900000

# OpenAI-compatible chat endpoint
V3_LLM_API_KEY=
V3_LLM_BASE_URL=https://api.openai.com/v1
V3_LLM_QUICK_MODEL=gpt-5-mini
V3_LLM_DEEP_MODEL=gpt-5
V3_MAX_DEBATE_ROUNDS=1
V3_MAX_RISK_ROUNDS=1

# Forward execution evaluation
V3_EXECUTION_MAX_BARS=96

# Optional structured social feed. Expected JSON array or {items/posts/messages:[...]}
V3_SOCIAL_CONTEXT_URL=
# Leave blank to disable the social analyst rather than fabricate social evidence.

# Optional RSS override
V3_NEWS_RSS_URL=https://www.coindesk.com/arc/outboundfeeds/rss/

# V3 never creates live Trade documents. Keep it in shadow mode until validated.
